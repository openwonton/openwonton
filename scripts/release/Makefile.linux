WONTON_VERSION ?= $(NOMAD_VERSION)
WONTON_VERSION ?= 0.9.0-dev
NOMAD_VERSION ?= $(WONTON_VERSION)

WONTON_MAIN_VERSION := $(shell echo $(WONTON_VERSION) | cut -d- -f1)
WONTON_PRERELEASE_VERSION := $(shell echo $(WONTON_VERSION) | sed 's|^[^-]*-\{0,1\}||g' )

update_version:
	@echo "updating version to $(WONTON_MAIN_VERSION)-$(WONTON_PRERELEASE_VERSION)"
	@sed -i.bak -e 's|\(Version * = *"\)[^"]*|\1$(WONTON_MAIN_VERSION)|g' version/version.go
	@sed -i.bak -e 's|\(VersionPrerelease * = *"\)[^"]*|\1$(WONTON_PRERELEASE_VERSION)|g' version/version.go
	@rm -rf version/version.go.bak

PRERELEASE_TARGET = prerelease
RELEASE_TARGET = release

build_releases:
	@echo "======>> installing dependencies"
	$(MAKE) deps

	@echo "======>> pre-releasing"
	$(MAKE) $(PRERELEASE_TARGET)

	@echo "======>> committing generated files"
	git add -A .
	find . -name '*.generated.go' -not -path './vendor/*' -exec git add -f '{}' \;
# skip comitting files if there are no generated files
# if prerelease process was a no-op
	if ! git diff-index --quiet HEAD --; \
	then \
		git commit --author 'OpenWonton Release Bot <openwonton@users.noreply.github.com>' \
			--message "Generate files for $(WONTON_VERSION) release"; \
	fi

	@echo "======>> building release artifacts"
	$(MAKE) $(RELEASE_TARGET)
