#!/usr/bin/env bash

# A script for building Linux and Windows OpenWonton release binaries inside Docker
#
# This is a helper script file that is expected to be invoked
# within a docker container with an image created with the Dockerfile present on this directory.
#
# A sample way of invoking the script is
# ```
# docker run --rm \
#        -v $(pwd)/.git:/tmp/wonton-git:ro \
#        -v /tmp/generated-repo:/tmp/artifacts:rw \
#        -e "PRERELEASE_TARGET=${PRERELEASE_TARGET}" \
#        -e "RELEASE_TARGET=${RELEASE_TARGET}" \
#        -e "WONTON_VERSION=${WONTON_VERSION}" \
#        wonton-builder:latest \
#        /tmp/scripts/docker-build-all
# ```
# Namely the script takes the following arguments:
# * `/tmp/wonton-git` path being a read-only .git directory with HEAD being the sha to be released
#   (`/tmp/nomad-git` is still accepted for compatibility)
# * `WONTON_VERSION` env-var being the release version to be cut (e.g. `0.9.1-rc1`)
#   (`NOMAD_VERSION` is still accepted for compatibility)
# * `PRERELEASE_TARGET` env-var being the prerelease make target, typically `prerelease`.  Use `help` to skip `prerelease` step
# * `RELEASE_TARGET` env-var being the release make target, typically `release`.
#
#
# The script would then run prerelease steps, commits any generated files, and build all binary files
# and stores them to `/tmp/artifacts/repo`.

set -o errexit
set -o xtrace

WONTON_VERSION="${WONTON_VERSION:-$NOMAD_VERSION}"
if [[ -z "${WONTON_VERSION}" ]]; then
  echo "WONTON_VERSION (or NOMAD_VERSION for compatibility) is required" >&2
  exit 1
fi

source_git_dir="/tmp/wonton-git"
if [[ ! -d "${source_git_dir}" ]]; then
  source_git_dir="/tmp/nomad-git"
fi
if [[ ! -d "${source_git_dir}" ]]; then
  echo "Expected a .git directory at /tmp/wonton-git (or /tmp/nomad-git)" >&2
  exit 1
fi

cp -r "${source_git_dir}" /opt/gopath/src/github.com/openwonton/openwonton/.git

cd /opt/gopath/src/github.com/openwonton/openwonton

# checkout directory from .git and ensures a prestine state
git checkout .

make -f ./scripts/release/Makefile.linux \
  "WONTON_VERSION=${WONTON_VERSION}" \
  "NOMAD_VERSION=${WONTON_VERSION}" \
  "PRERELEASE_TARGET=${PRERELEASE_TARGET}" \
  "RELEASE_TARGET=${RELEASE_TARGET}" \
  update_version build_releases

cp -r /opt/gopath/src/github.com/openwonton/openwonton \
    /tmp/artifacts/repo
